@page "/contact"
@using System.ComponentModel.DataAnnotations
@using PetShopApp.Data
@using PetShopApp.Models
@inject ApplicationDbContext DbContext

<div class="container mt-5 pt-5 pb-5 contact-page">
    <div class="row g-5">
        <div class="col-lg-5">
            <h2 class="fw-bold text-uppercase mb-4" style="letter-spacing: 3px;">
                Contact Us
            </h2>

            <p class="text-secondary mb-4">
                Have a question about your order or a product for your pet?
                Send us a message using the form.
            </p>

            <h3 class="h6 fw-bold text-uppercase">Helpful Links</h3>
            <ul class="list-unstyled mb-4">
                <li class="mb-2"><a href="/profile">My Account</a></li>
                <li class="mb-2"><a href="/shipping-policy">Shipping Policy</a></li>
                <li class="mb-2"><a href="/returns-exchanges">Returns &amp; Exchanges</a></li>
            </ul>

            <p class="text-secondary small mb-0">
                For order questions, include your order number if you have it.
                For product questions, include the product name and the size or weight,
                if applicable.
            </p>

            <img src="/images/petBkgContactpng.png"
                 alt=""
                 class="contact-pet d-none d-lg-block mt-4" />
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-0 p-4 p-md-5">
                <EditForm Model="@contactModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label for="contact-name" class="form-label fw-bold text-uppercase small">
                                Your Name
                            </label>
                            <InputText id="contact-name"
                                       class="form-control rounded-0 border-dark-subtle py-2"
                                       @bind-Value="contactModel.Name"
                                       placeholder="Full Name" />
                            <ValidationMessage For="@(() => contactModel.Name)" class="text-danger small" />
                        </div>

                        <div class="col-md-6 mb-4">
                            <label for="contact-email" class="form-label fw-bold text-uppercase small">
                                Email Address
                            </label>
                            <InputText id="contact-email"
                                       class="form-control rounded-0 border-dark-subtle py-2"
                                       @bind-Value="contactModel.Email"
                                       placeholder="email@example.com" />
                            <ValidationMessage For="@(() => contactModel.Email)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="contact-subject" class="form-label fw-bold text-uppercase small">
                            Subject
                        </label>
                        <InputSelect id="contact-subject"
                                     class="form-select rounded-0 border-dark-subtle py-2"
                                     @bind-Value="contactModel.Subject">
                            <option value="">Select a topic...</option>
                            <option value="Order Status">Order Status</option>
                            <option value="Shipping and Delivery">Shipping &amp; Delivery</option>
                            <option value="Returns and Exchanges">Returns &amp; Exchanges</option>
                            <option value="Damaged or Missing Items">Damaged or Missing Items</option>
                            <option value="Product Questions">Pet Food &amp; Product Questions</option>
                            <option value="Account Help">Account Help</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => contactModel.Subject)" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label for="contact-message" class="form-label fw-bold text-uppercase small">
                            Message
                        </label>
                        <InputTextArea id="contact-message"
                                       class="form-control rounded-0 border-dark-subtle"
                                       rows="5"
                                       @bind-Value="contactModel.Message"
                                       placeholder="Tell us how we can help."
                                       aria-describedby="contact-message-hint" />

                        <div id="contact-message-hint" class="form-text">
                            Please do not include passwords or payment card details.
                        </div>

                        <ValidationMessage For="@(() => contactModel.Message)" class="text-danger small" />
                    </div>

                    @if (showSuccessMessage)
                    {
                        <div class="bg-black text-white p-3 mb-4 rounded-0 d-flex align-items-center animate__animated animate__fadeIn">
                            <i class="bi bi-check2-all me-2 fs-5"></i>
                            <span class="fw-bold small text-uppercase" style="letter-spacing: 1px;">
                                Message sent! We'll get back to you soon.
                            </span>
                        </div>
                    }

                    <button type="submit"
                            class="btn btn-dark w-100 py-3 fw-bold text-uppercase rounded-0 transition-hover">
                        Send Message
                    </button>
                </EditForm>
            </div>
        </div>

        
    </div>
</div>

@code {
    private ContactForm contactModel = new();
    private bool showSuccessMessage = false;

    private async Task HandleSubmit()
    {
        try
        {
            var newMessage = new ContactMessage
            {
                Name = contactModel.Name,
                Email = contactModel.Email,
                Subject = contactModel.Subject,
                Message = contactModel.Message,
                CreatedAt = DateTime.Now
            };

            DbContext.ContactMessages.Add(newMessage);
            await DbContext.SaveChangesAsync();

            showSuccessMessage = true;
            contactModel = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Critical error saving contact message: {ex.Message}");
        }

        StateHasChanged();

        await Task.Delay(5000);
        showSuccessMessage = false;
        StateHasChanged();
    }

    public class ContactForm
    {
        [Required(ErrorMessage = "Please tell us your name.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please select a subject.")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "The message cannot be empty.")]
        [StringLength(1000, MinimumLength = 10, ErrorMessage = "Message must be between 10 and 1000 characters.")]
        public string Message { get; set; } = string.Empty;
    }
}

<style>
    .contact-page .form-control:focus,
    .contact-page .form-select:focus {
        border-color: #000;
        box-shadow: none;
    }

    .contact-page .transition-hover:hover {
        background-color: #333;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

    .contact-page .contact-pet {
        width: 100%;
        max-width: 550px;
        height: auto;
        
        object-fit: contain;
        object-position: center bottom;
    }
</style>