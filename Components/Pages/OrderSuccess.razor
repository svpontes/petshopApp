@page "/order-success/{OrderId:int}"
@using Microsoft.EntityFrameworkCore
@using PetShopApp.Models
@using PetShopApp.Data
@using PetShopApp.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager NavManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthService AuthService

<PageTitle>Order Confirmation | Pet Love Care</PageTitle>

<div class="container mt-5 pt-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (isLoading)
            {
                <p role="status">Loading your order...</p>
            }
            else if (loadFailed)
            {
                <div class="alert alert-danger" role="alert">
                    Your order could not be loaded. Please try again.
                </div>
            }
            else if (order is null)
            {
                <h1 class="h3 fw-bold">Order not available</h1>
                <p>
                    Please sign in to view your order.
                    The order must belong to your account.
                </p>
            }
            else
            {
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle-fill display-1 text-success"></i>
                    <h1 class="fw-bold mt-3">Order Confirmed</h1>
                    <p>Your order has been placed successfully.</p>
                </div>

                <div class="card rounded-0 mb-4">
                    <div class="card-body">
                        <h2 class="h5 fw-bold">
                            Order #@order.Id
                        </h2>

                        <p class="mb-1">
                            Date: @order.OrderDate.ToString("yyyy-MM-dd HH:mm")
                        </p>

                        <p class="mb-1">
                            Status: @order.Status
                        </p>

                        <hr />

                        <h3 class="h6 fw-bold">Purchased Items</h3>

                        <ul class="list-group list-group-flush">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item px-0">
                                    <strong>@item.ProductName</strong>

                                    @if (!string.IsNullOrWhiteSpace(item.Size))
                                    {
                                        <div>Option: @item.Size</div>
                                    }

                                    <div>Quantity: @item.Quantity</div>

                                    <div>
                                        Unit price: @item.Price.ToString("C")
                                    </div>

                                    <div>
                                        Subtotal:
                                        @((item.Price * item.Quantity).ToString("C"))
                                    </div>
                                </li>
                            }
                        </ul>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <strong>Total</strong>
                            <strong>@order.TotalAmount.ToString("C")</strong>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a href="/catalog" class="btn btn-dark rounded-0">
                    Continue Shopping
                </a>

                <a href="/" class="btn btn-outline-dark rounded-0">
                    Back to Home
                </a>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public int OrderId { get; set; }

    private Order? order;
    private bool isLoading = true;
    private bool loadFailed;

    protected override async Task OnParametersSetAsync()
    {
         // Reject deleted accounts and sessions with an invalid security stamp.
        if (!await AuthService.IsAuthorizedAsync())
        {
            NavManager.NavigateTo("/login");
            return;
        }
        order = null;
        loadFailed = false;
        isLoading = true;

        var customer = AuthService.CurrentUser;

        if (customer is null || OrderId <= 0)
        {
            isLoading = false;
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var savedOrder = await db.Orders
                .AsNoTracking()
                .FirstOrDefaultAsync(o =>
                    o.Id == OrderId &&
                    o.UserId == customer.Id);

            if (ReferenceEquals(AuthService.CurrentUser, customer))
                order = savedOrder;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}
