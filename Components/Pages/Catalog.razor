@page "/catalog"
@using Microsoft.EntityFrameworkCore
@using PetShopApp.Models
@using PetShopApp.Components
@using PetShopApp.Components.Shared
@inject PetShopApp.Services.ProductService ProductService
@rendermode InteractiveServer
@inject PetShopApp.Services.CartService CartService

@* --- PRODUCT CATALOG COMPONENT ---
   Purpose: Displays the full collection of available products.
   Includes features like dynamic image rendering, size badges, 
   and an integrated Quick View purchasing system.
*@

<PageTitle>text for access catalog or categories</PageTitle>

<section class="container py-5">
    <h2 class="fw-bold text-uppercase mb-4">Products</h2>

    @* --- EMPTY STATE HANDLER --- *@
    @if (products == null || !products.Any())
    {
        <div class="text-center py-5">
            <p class="lead text-muted mb-0">No products available yet.</p>
        </div>
    }
    else
    {
        @* --- PRODUCT GRID --- *@
        <div class="row g-4">
            @foreach (var product in products)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        @* Navigation link to the full product detail page *@
                        <a href="/product/@product.Id" class="text-decoration-none text-dark">
                            <div class="p-4 text-center" style="background-color:#f8f9fa;">
                                <img src="@GetImageUrl(product.ImageUrl)"
                                     alt="@product.Name"
                                     class="img-fluid"
                                     style="height: 320px; object-fit: contain;"
                                     onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column">
                            <a href="/product/@product.Id" class="text-decoration-none text-dark">
                                <h5 class="fw-bold text-uppercase mb-2">@product.Name</h5>
                            </a>

                            <p class="text-muted small flex-grow-1">@product.Description</p>

                            @* --- SIZE AVAILABILITY BADGES --- changed for show only options available for this product *@
                            @if (product.Variants.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @foreach (var variant in product.Variants.OrderBy(v => GetWeightInPounds(v.Label))
                                                .ThenBy(v => v.Id))
                                        {
                                            var isSelected =
                                                selectedVariants.TryGetValue(product.Id, out var selected) &&
                                                selected.Id == variant.Id;

                                            <button type="button"
                                                    class="btn btn-sm @(isSelected ? "btn-dark" : "btn-outline-dark")"
                                                    aria-pressed="@(isSelected ? "true" : "false")"
                                                    @onclick="() => selectedVariants[product.Id] = variant">
                                                @variant.Label
                                            </button>
                                        }
                                    </div>
                                }

                            @* --- ACTIONS AREA --- *@
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                @{
                                var displayPrice = selectedVariants.TryGetValue(product.Id, out var chosen)
                                    ? chosen.Price
                                    : product.Price;
                                }
                                <span class="fw-bold">$@displayPrice.ToString("0.00")</span>

                                @* Triggers the Quick View panel instead of full navigation *@
                                <button class="btn btn-dark rounded-0"
                                    disabled="@(product.Variants.Count > 0 && !selectedVariants.ContainsKey(product.Id))"
                                    @onclick="() => AddFromCatalog(product)">
                                    @(product.Variants.Count > 0 && !selectedVariants.ContainsKey(product.Id)
                                    ? "SELECT AN OPTION"
                                    : "ADD TO CART")
                                </button>
                                
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* Shared component for rapid purchasing without page navigation *@
<ProductQuickView Show="isPanelOpen"
                  Product="selectedProduct"
                  OnClose="HandleClose" />

@code {
    private List<Product> products = new();
    private bool isPanelOpen;
    private Product? selectedProduct;
    private readonly Dictionary<int, ProductVariant> selectedVariants = new();
    /// <summary>
    /// Lifecycle method: Fetches products from the database alphabetically by name.
    /// Includes data sanitization for images and sizes.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetCatalogProductsAsync();
        foreach (var product in products)
        {
            var defaultVariant = product.Variants.FirstOrDefault(
            variant => GetWeightInPounds(variant.Label) == 2.2m);
        
            if (defaultVariant is not null)
            {
                selectedVariants.TryAdd(product.Id, defaultVariant);
            }
        }
    }

    /// <summary>
    /// Opens the Quick View side panel for the selected product.
    /// </summary>
    private void OpenQuickView(Product product)
    {
        selectedProduct = product;
        isPanelOpen = true;
        StateHasChanged();
    }

    /// <summary>
    /// Resets state and closes the side panel.
    /// </summary>
    private void HandleClose()
    {
        isPanelOpen = false;
        selectedProduct = null;
        StateHasChanged();
    }

    /// <summary>
    /// Validates image URLs and returns a placeholder path if empty.
    /// </summary>
    private static string GetImageUrl(string? url)
    {
        return string.IsNullOrWhiteSpace(url)
            ? "/images/placeholder.png"
            : url.Trim();
    }
    private void AddFromCatalog(Product product)
    {
    if (product.Variants.Count == 0)
    {
        OpenQuickView(product);
        return;
    }

    if (selectedVariants.TryGetValue(product.Id, out var variant))
    {
        CartService.AddToCart(product, variant.Label, 1, variant);
    }
    }
    private static decimal GetWeightInPounds(string label)
    {
    var text = label.Trim();

    if (text.EndsWith(" lb", StringComparison.OrdinalIgnoreCase) &&
        decimal.TryParse(
            text[..^3].Trim(),
            System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture,
            out var weight))
    {
        return weight;
    }

    return decimal.MaxValue;
    }
}