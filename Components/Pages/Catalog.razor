@page "/catalog"
@using PetShopApp.Models
@using PetShopApp.Components
@using PetShopApp.Components.Shared
@inject PetShopApp.Services.ProductService ProductService
@inject ILogger<Catalog> Logger
@rendermode InteractiveServer
@inject PetShopApp.Services.CartService CartService

@* --- PRODUCT CATALOG COMPONENT ---
   Purpose: Displays available products and filters them by their category ID.
   Includes features like dynamic image rendering, size badges,
   and an integrated Quick View purchasing system.
*@

<PageTitle>Catalog | Pet Love Care</PageTitle>

<section class="container py-5">
    <h2 class="fw-bold text-uppercase mb-4">Products</h2>

    @* Load category options through the shared service and bind the selected ID. *@
    <div class="row align-items-end g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-4">
            <label for="catalog-category" class="form-label fw-bold">
                Category
            </label>
            <select id="catalog-category"
                    class="form-select rounded-0"
                    @bind="selectedCategoryId"
                    @bind:after="LoadCatalogAsync"
                    disabled="@isLoading">
                <option value="">All categories</option>
                @foreach (var category in categories)
                {
                    <option @key="category.Id" value="@category.Id">
                        @category.Name
                    </option>
                }
            </select>
        </div>
        @if (!isLoading && string.IsNullOrEmpty(loadError))
        {
            <div class="col-12 col-md-auto">
                <p class="text-muted small mb-0" role="status" aria-live="polite">
                    @products.Count product(s) found.
                </p>
            </div>
        }
    </div>

    @* Distinguish loading, failed queries and genuinely empty category results. *@
    @if (isLoading)
    {
        <p class="text-muted py-4" role="status">Loading products...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="alert alert-danger rounded-0" role="alert">
            <p>@loadError</p>
            <button type="button" class="btn btn-outline-dark rounded-0"
                    @onclick="LoadCatalogAsync">
                Try again
            </button>
        </div>
    }
    else if (products.Count == 0)
    {
        <div class="text-center py-5">
            <p class="lead text-muted mb-0">
                @(selectedCategoryId is null
                    ? "No products available yet."
                    : "No products in this category.")
            </p>
        </div>
    }
    else
    {
        @* --- PRODUCT GRID --- *@
        <div class="row g-4">
            @foreach (var product in products)
            {
                <div @key="product.Id" class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        @* Navigation link to the full product detail page *@
                        <a href="/product/@product.Id" class="text-decoration-none text-dark">
                            <div class="p-4 text-center" style="background-color:#f8f9fa;">
                                <img src="@GetImageUrl(product.ImageUrl)"
                                     alt="@product.Name"
                                     class="img-fluid"
                                     style="height: 320px; object-fit: contain;"
                                     onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column">
                            <a href="/product/@product.Id" class="text-decoration-none text-dark">
                                <h5 class="fw-bold text-uppercase mb-2">@product.Name</h5>
                            </a>

                            <p class="text-muted small flex-grow-1">@product.Description</p>

                            @* --- SIZE AVAILABILITY BADGES --- changed for show only options available for this product *@
                            @if (product.Variants.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @foreach (var variant in product.Variants.OrderBy(v => GetWeightInPounds(v.Label))
                                                .ThenBy(v => v.Id))
                                        {
                                            var isSelected =
                                                selectedVariants.TryGetValue(product.Id, out var selected) &&
                                                selected.Id == variant.Id;

                                            <button type="button"
                                                    class="btn btn-sm @(isSelected ? "btn-dark" : "btn-outline-dark")"
                                                    aria-pressed="@(isSelected ? "true" : "false")"
                                                    @onclick="() => selectedVariants[product.Id] = variant">
                                                @variant.Label
                                            </button>
                                        }
                                    </div>
                                }

                            @* --- ACTIONS AREA --- *@
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                @{
                                var displayPrice = selectedVariants.TryGetValue(product.Id, out var chosen)
                                    ? chosen.Price
                                    : product.Price;
                                }
                                <span> <PromotionPrice RegularUnitPrice="displayPrice"></PromotionPrice> </span>

                                @* Triggers the Quick View panel instead of full navigation *@
                                <button class="btn btn-dark rounded-0"
                                    @onclick="() => OpenQuickView(product)">
                                    ADD TO CART
                                </button>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* Shared component for rapid purchasing without page navigation *@
@if (isPanelOpen && selectedProduct is not null)
{
    <ProductQuickView @key="selectedProduct.Id"
                      Show="true"
                      Product="selectedProduct"
                      InitialVariant="selectedVariants.GetValueOrDefault(selectedProduct.Id)"
                      OnClose="HandleClose" />
}

@code {
    private List<Product> products = new();
    private List<Category> categories = new();
    private int? selectedCategoryId;
    private bool isLoading = true;
    private string loadError = "";

    // Only the latest category request may update the visible catalog.
    private int catalogLoadVersion;
    private bool isPanelOpen;
    private Product? selectedProduct;
    private readonly Dictionary<int, ProductVariant> selectedVariants = new();
    /// <summary>
    /// Loads the first unfiltered catalog and its category options.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
    }

    /// <summary>
    /// Reloads category options and the products belonging to the selected category.
    /// Stale asynchronous responses cannot replace a more recent selection.
    /// </summary>
    private async Task LoadCatalogAsync()
    {
        var requestVersion = ++catalogLoadVersion;
        var requestedCategoryId = selectedCategoryId;
        isLoading = true;
        loadError = "";

        // Close the old product panel before replacing the displayed collection.
        isPanelOpen = false;
        selectedProduct = null;

        try
        {
            var loadedCategories = await ProductService.GetCategoriesAsync();

            // Return to all products if the previously selected category was removed.
            if (requestedCategoryId is int categoryId &&
                !loadedCategories.Any(category => category.Id == categoryId))
            {
                requestedCategoryId = null;
            }

            var loadedProducts = await ProductService
                .GetCatalogProductsAsync(requestedCategoryId);

            if (requestVersion != catalogLoadVersion)
                return;

            categories = loadedCategories;
            products = loadedProducts;
            selectedCategoryId = requestedCategoryId;
            selectedVariants.Clear();

            foreach (var product in products)
            {
                // Prefer 2.2 lb; otherwise select the first available ordered variant.
                var defaultVariant = product.Variants.FirstOrDefault(
                    variant => GetWeightInPounds(variant.Label) == 2.2m)
                    ?? product.Variants
                        .OrderBy(variant => GetWeightInPounds(variant.Label))
                        .ThenBy(variant => variant.Id)
                        .FirstOrDefault();

                if (defaultVariant is not null)
                    selectedVariants[product.Id] = defaultVariant;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The product catalog could not be loaded.");

            if (requestVersion == catalogLoadVersion)
            {
                products.Clear();
                selectedVariants.Clear();
                loadError = "We couldn't load the catalog. Please try again.";
            }
        }
        finally
        {
            if (requestVersion == catalogLoadVersion)
                isLoading = false;
        }
    }

    /// <summary>
    /// Opens the Quick View side panel for the selected product.
    /// </summary>
    private void OpenQuickView(Product product)
    {
        selectedProduct = product;
        isPanelOpen = true;
        StateHasChanged();
    }

    /// <summary>
    /// Resets state and closes the side panel.
    /// </summary>
    private void HandleClose()
    {
        isPanelOpen = false;
        selectedProduct = null;
        StateHasChanged();
    }

    /// <summary>
    /// Validates image URLs and returns a placeholder path if empty.
    /// </summary>
    private static string GetImageUrl(string? url)
    {
        return string.IsNullOrWhiteSpace(url)
            ? "/images/placeholder.png"
            : url.Trim();
    }
    private void AddFromCatalog(Product product)
    {
    if (product.Variants.Count == 0)
    {
        OpenQuickView(product);
        return;
    }

    if (selectedVariants.TryGetValue(product.Id, out var variant))
    {
        CartService.AddToCart(product, variant.Label, 1, variant);
    }
    }
    private static decimal GetWeightInPounds(string? label)
    {
    // Accept labels such as "2.2 lb" and "2.2lb".
    var text = label?.Trim() ?? "";

    if (!text.EndsWith("lb", StringComparison.OrdinalIgnoreCase))
        return decimal.MaxValue;

    // Read the numeric weight independently of the computer's culture.
    var numericText = text[..^2].Trim();

    if (decimal.TryParse(
            numericText,
            System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture,
            out var weight) && weight > 0)
    {
        return weight;
    }

    // Place unrecognized options after valid weights.
    return decimal.MaxValue;
    }
}