
@page "/cart"
@implements IDisposable
@using PetShopApp.Services
@inject CartService CartService
@inject NavigationManager NavManager

@* --- SHOPPING CART COMPONENT ---
   Purpose: Provides a detailed view of items added to the cart.
   Allows users to adjust quantities, remove items, and see the total cost
   before proceeding to checkout.
*@

<div class="container mt-5 pt-5 pb-5">
    <h2 class="fw-bold mb-4 text-uppercase" style="letter-spacing: 2px;">
        Your Shopping Bag
    </h2>

    @if (CartService.CartItems.Any())
    {
        <div class="row">

            @* --- LEFT COLUMN: ITEM LIST --- *@
            <div class="col-lg-8">
                @foreach (var item in CartService.CartItems)
                {
                    <div class="card mb-3 border-0 border-bottom rounded-0 bg-transparent">
                        <div class="row g-0 align-items-center py-3">

                            @* Product Thumbnail *@
                            <div class="col-md-2 col-3">
                                <img src="@item.Product.ImageUrl"
                                     class="img-fluid"
                                     alt="@item.Product.Name">
                            </div>

                            @* Product Info *@
                            <div class="col-md-6 col-9 px-3">
                                <h5 class="fw-bold m-0">
                                    <a href="@($"/product/{item.Product.Id}")"
                                    class="text-dark text-decoration-none">
                                        @item.Product.Name
                                    </a>
                                </h5>

                                @if (!string.IsNullOrWhiteSpace(item.Size))
                                {
                                    <p class="text-secondary small mb-1">
                                        Size:
                                        <span class="text-dark fw-bold">
                                            @item.Size
                                        </span>
                                    </p>
                                }

                                <p class="mb-1">
                                    Unit price: @item.Product.Price.ToString("C")
                                </p>

                                <p class="fw-bold">
                                    Subtotal: @((item.Product.Price * item.Quantity).ToString("C"))
                                </p>
                            </div>

                            @* Quantity Controls and Remove Button *@
                            <div class="col-md-4 d-flex align-items-center justify-content-between px-3">
                                <div class="d-flex align-items-center border px-2">

                                    <button type="button"
                                            class="btn btn-sm p-1"
                                            aria-label="Decrease quantity"
                                            @onclick="() => UpdateQty(item, -1)">
                                        -
                                    </button>

                                    <span class="mx-3 fw-bold">
                                        @item.Quantity
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm p-1"
                                            aria-label="Increase quantity"
                                            @onclick="() => UpdateQty(item, 1)">
                                        +
                                    </button>
                                </div>

                                <button type="button"
                                        class="btn text-danger ms-3"
                                        aria-label="Remove item from cart"
                                        @onclick="() => RemoveItem(item)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* --- RIGHT COLUMN: ORDER SUMMARY --- *@
            <div class="col-lg-4">
                <div class="card p-4 bg-light border-0 rounded-0 shadow-sm">
                    <h4 class="fw-bold mb-4">Summary</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>@CartService.TotalPrice.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4">
                        <span>Shipping</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 fw-bold">Total</span>
                        <span class="h5 fw-bold">
                            @CartService.TotalPrice.ToString("C")
                        </span>
                    </div>

                    @* Action Buttons *@
                    <button type="button"
                            @onclick="GoToCheckout"
                            class="btn btn-dark w-100 py-3 fw-bold text-uppercase rounded-0 mb-2">
                        Checkout Now
                    </button>

                    <a href="/catalog"
                       class="btn btn-outline-dark w-100 py-2 rounded-0 small">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @* --- EMPTY CART FALLBACK --- *@
        <div class="text-center py-5">
            <i class="bi bi-bag-x display-1 text-secondary"></i>

            <h3 class="mt-4 fw-bold">
                Your bag is empty.
            </h3>

            <p class="text-secondary">
                Browse our pet products and add something to your cart.
            </p>

            <a href="/catalog"
               class="btn btn-dark px-5 py-3 mt-3 rounded-0 fw-bold">
                DISCOVER PRODUCTS
            </a>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Updates the quantity of a cart item.
    /// Change can be +1 or -1.
    /// </summary>
    private void UpdateQty(CartItem item, int change)
    {
        CartService.UpdateQuantity(
            item.Product.Id,
            item.Size,
            change
        );
    }

    /// <summary>
    /// Removes the selected item from the cart.
    /// </summary>
    private void RemoveItem(CartItem item)
    {
        CartService.RemoveFromCart(
            item.Product.Id,
            item.Size
        );
    }

    /// <summary>
    /// Subscribes to cart changes to update the UI.
    /// </summary>
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    /// <summary>
    /// Unsubscribes from events when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }

    /// <summary>
    /// Navigates to the checkout page.
    /// </summary>
    private void GoToCheckout()
    {
        NavManager.NavigateTo("/checkout");
    }
}
