
@page "/cart"
@implements IDisposable
@using PetShopApp.Services
@inject CartService CartService
@inject ProductService ProductService
@inject ILogger<Cart> Logger
@inject NavigationManager NavManager

@* --- SHOPPING CART COMPONENT ---
   Purpose: Provides a detailed view of items added to the cart.
   Allows users to adjust quantities, remove items, and see the total cost
   before proceeding to checkout.
*@

<PageTitle>Cart | Pet Love Care</PageTitle>

<div class="container mt-5 pt-5 pb-5">
    <h2 class="fw-bold mb-4 text-uppercase text-center" style="letter-spacing: 2px;">
        Your Shopping Bag
    </h2>

    @if (!string.IsNullOrEmpty(CartService.LastError))
    {
        <div class="alert alert-warning rounded-0" role="alert">@CartService.LastError</div>
    }
    @if (!string.IsNullOrEmpty(stockError))
    {
        <div class="alert alert-warning rounded-0" role="alert">@stockError</div>
    }

    @if (CartService.CartItems.Any())
    {
        <div class="row">

            @* --- LEFT COLUMN: ITEM LIST --- *@
            <div class="col-lg-8">
                @foreach (var item in CartService.CartItems)
                {
                    <div class="card mb-3 border-0 border-bottom rounded-0 bg-transparent">
                        <div class="row g-0 align-items-center py-3">

                            @* Product Thumbnail *@
                            <div class="col-md-2 col-3">
                                <img src="@item.Product.ImageUrl"
                                     class="img-fluid"
                                     alt="@item.Product.Name">
                            </div>

                            @* Product Info *@
                            <div class="col-md-6 col-9 px-3">
                                <h5 class="fw-bold m-0">
                                    <a href="@($"/product/{item.Product.Id}")"
                                       class="text-dark text-decoration-none">
                                        @item.Product.Name
                                    </a>
                                </h5>

                                @if (!string.IsNullOrWhiteSpace(item.Size))
                                {
                                    <p class="text-secondary small mb-1">
                                        Size:
                                        <span class="text-dark fw-bold">
                                            @item.Size
                                        </span>
                                    </p>
                                }

                                <p class="mb-1">
                                    Unit price: @item.UnitPrice.ToString("C")
                                </p>

                                @if (ProductStock.Quantity(item.Product, item.Size) == 0)
                                {
                                    <p class="text-danger small fw-bold">OUT OF STOCK — remove this item before checkout.</p>
                                }
                                <p class="fw-bold">
                                    Subtotal: @((item.UnitPrice * item.Quantity).ToString("C"))
                                </p>
                            </div>

                            @* Quantity Controls and Remove Button *@
                            <div class="col-md-4 d-flex align-items-center justify-content-between px-3">
                                <div class="d-flex align-items-center border px-2">

                                    <button type="button"
                                            class="btn btn-sm p-1"
                                            aria-label="Decrease quantity"
                                            @onclick="() => UpdateQty(item, -1)">
                                        -
                                    </button>

                                    <span class="mx-3 fw-bold">
                                        @item.Quantity
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm p-1"
                                            aria-label="Increase quantity"
                                            disabled="@(isChecking || CartService.RemainingQuantity(item.Product, item.Size) <= 0)"
                                            @onclick="() => UpdateQty(item, 1)">
                                        +
                                    </button>
                                </div>

                                <button type="button"
                                        class="btn text-danger ms-3"
                                        aria-label="Remove item from cart"
                                        @onclick="() => RemoveItem(item)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* --- RIGHT COLUMN: ORDER SUMMARY --- *@
            <div class="col-lg-4">
                <div class="card p-4 bg-light border-0 rounded-0 shadow-sm">
                    <h4 class="fw-bold mb-4">Summary</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>@CartService.TotalPrice.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4">
                        <span>Shipping</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 fw-bold">Total</span>
                        <span class="h5 fw-bold">
                            @CartService.TotalPrice.ToString("C")
                        </span>
                    </div>

                    @* Action Buttons *@
                    <button type="button"
                            @onclick="GoToCheckout"
                            class="btn btn-dark w-100 py-3 fw-bold text-uppercase rounded-0 mb-2">
                        Checkout Now
                    </button>

                    <a href="/catalog"
                       class="btn btn-outline-dark w-100 py-2 rounded-0 small">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @* --- EMPTY CART FALLBACK --- *@
        <div class="text-center py-5">
            <img src="/images/petBkgCartEmpty.png"
                 alt=""
                 class="img-fluid d-block mx-auto mb-4"
                 style="width: 360px; max-width: 100%; height: auto; transform: translateX(-10px)" />

            <h3 class="fw-bold">Your bag is empty.</h3>

            <p class="text-secondary">
                Browse our pet products and add something to your cart.
            </p>

            <a href="/catalog"
               class="btn btn-dark px-5 py-3 mt-3 rounded-0 fw-bold">
                DISCOVER PRODUCTS
            </a>
        </div>
    }
</div>

@code {
    private bool isChecking;
    private string stockError = "";
    /// <summary>
    /// Updates the quantity of a cart item.
    /// Change can be +1 or -1.
    /// </summary>
    private async Task UpdateQty(CartItem item, int change)
    {
        if (isChecking) return;
        stockError = "";
        isChecking = true;
        try
        {
            if (change > 0)
            {
                var current = await ProductService.GetProductByIdAsync(item.Product.Id);
                if (current is null)
                {
                    stockError = "This product is no longer available. Please remove it from your bag.";
                    return;
                }
                CartService.RefreshProduct(current);
            }
            CartService.UpdateQuantity(
            item.Product.Id,
            item.Size,
            change
            );
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Cart inventory check failed.");
            stockError = "We couldn't check availability. Please try again.";
        }
        finally { isChecking = false; }
    }

    /// <summary>
    /// Removes the selected item from the cart.
    /// </summary>
    private void RemoveItem(CartItem item)
    {
        CartService.RemoveFromCart(
            item.Product.Id,
            item.Size
        );
    }

    /// <summary>
    /// Subscribes to cart changes to update the UI.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        try
        {
            foreach (var id in CartService.CartItems.Select(item => item.Product.Id).Distinct().ToArray())
            {
                var product = await ProductService.GetProductByIdAsync(id);
                if (product is not null) CartService.RefreshProduct(product);
                else stockError = "A product in your bag is no longer available. Please remove it.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Cart inventory could not be refreshed.");
            stockError = "We couldn't refresh availability. It will be checked again at checkout.";
        }
    }

    /// <summary>
    /// Unsubscribes from events when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }

    /// <summary>
    /// Navigates to the checkout page.
    /// </summary>
    private void GoToCheckout()
    {
        NavManager.NavigateTo("/checkout");
    }
}
