@using PetShopApp.Components.Shared
@inject PetShopApp.Services.AuthService AuthService
@inject NavigationManager NavManager

@layout MainLayout

@page "/register"

@* --- REGISTRATION PAGE ---
   Purpose: Allows new users to create an account, persists data to SQLite,
   and uses an HTTP Identity endpoint for account creation and automatic sign-in.
   Security Update: Added real-time password strength validation.
*@

<PageTitle>Register | Pet Love Care</PageTitle>

<div class="container d-flex justify-content-center align-items-center py-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card border-0 shadow-lg p-4 text-dark rounded-0">
            <h2 class="text-center fw-bold mb-4" style="letter-spacing: 3px;">JOIN US</h2>

            <AccountForm Action="/account/register"
             ValidateBeforeSubmit="ValidateRegistration">
            @* User Input Fields with Two-Way Data Binding *@
            <div class="mb-3">
                <label for="register-name"
                    class="small fw-bold text-secondary">FULL NAME</label>
                <input id="register-name" name="name" type="text" @bind="name" maxlength="100" autocomplete="name" required class="form-control bg-transparent border-secondary text-dark rounded-0 py-2" placeholder="Your Name" />
            </div>

            <div class="mb-3">
                <label for="register-email"
                class="small fw-bold text-secondary">EMAIL</label>
                <input id="register-email" name="email" type="email" @bind="email" autocomplete="email" required class="form-control bg-transparent border-secondary text-dark rounded-0 py-2" placeholder="email@example.com" />
            </div>

            @* --- PASSWORD FIELD WITH REAL-TIME VALIDATION --- *@
            <div class="mb-4">
                <label for="register-password"
                class="small fw-bold text-secondary">PASSWORD</label>
                <input id="register-password" name="password" type="password" required
                       @bind="password"
                       @oninput="CheckPasswordStrength"
                       class="form-control bg-transparent border-secondary text-dark rounded-0 py-2" autocomplete="new-password" />

                @* Visual Security Checklist *@
                @* Mark completed password requirements without striking through the icons. *@
                <div class="register-security-checklist mt-3 p-3">
                    <h6 class="fw-bold text-uppercase mb-2">Security Checklist:</h6>

                    <ul class="list-unstyled mb-0">
                        <li class="@(hasMinLength ? "requirement-met" : "")">
                            <i class="bi @(hasMinLength ? "bi-check-circle-fill" : "bi-circle") me-2"
                            aria-hidden="true"></i>
                            <span>8+ Characters</span>
                        </li>

                        <li class="@(hasUpperCase ? "requirement-met" : "")">
                            <i class="bi @(hasUpperCase ? "bi-check-circle-fill" : "bi-circle") me-2"
                            aria-hidden="true"></i>
                            <span>1 Uppercase Letter</span>
                        </li>

                        <li class="@(hasNumber ? "requirement-met" : "")">
                            <i class="bi @(hasNumber ? "bi-check-circle-fill" : "bi-circle") me-2"
                            aria-hidden="true"></i>
                            <span>1 Number</span>
                        </li>

                        <li class="@(hasSpecialChar ? "requirement-met" : "")">
                            <i class="bi @(hasSpecialChar ? "bi-check-circle-fill" : "bi-circle") me-2"
                            aria-hidden="true"></i>
                            <span>1 Special Character</span>
                        </li>
                    </ul>
                </div>
            </div>
            @*Require the same password twice before creating a account*@
            <div class="mb-4">
                    <label for="register-confirm-password"
                        class="small fw-bold text-secondary">
                        CONFIRM PASSWORD
                    </label>

                    <input id="register-confirm-password"
                        name="confirmPassword"
                        type="password"
                        @bind="confirmPassword"
                        @bind:event="oninput"
                        required
                        autocomplete="new-password"
                        class="form-control bg-transparent border-secondary text-dark rounded-0 py-2"
                        aria-describedby="register-confirm-password-help" />

                    <small id="register-confirm-password-help"
                        class="d-block mt-1"
                        aria-live="polite">
                        @if (!string.IsNullOrEmpty(confirmPassword) &&
                            !string.Equals(password, confirmPassword, StringComparison.Ordinal))
                        {
                            <span class="text-danger">Passwords do not match.</span>
                        }
                        else
                        {
                            <span class="text-muted">Enter the same password again.</span>
                        }
                    </small>
            </div>
            @* Feedback for validation or database errors *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div role="alert"
                    class="alert alert-danger bg-transparent border-danger text-danger small rounded-0 mb-3">
                    @errorMessage

                </div>
            }

            <button type="submit" class="btn btn-dark w-100 fw-bold">
                REGISTER
            </button>

            <div class="text-center mt-3">
                <a href="/login" class="text-secondary small text-decoration-none hover-white">Already a member? Login here</a>
            </div>
            </AccountForm>
        </div>
    </div>
</div>
@code {
    private string name = "";
    private string email = "";
    private string password = "";
    // Keep local validation feedback separate from server feedback.
    private string localErrorMessage = "";
    // Keep confirmation separate from the password sent to Identity.
    private string confirmPassword = "";
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    // Display only predefined feedback; never render raw exception details.
    private string errorMessage => !string.IsNullOrEmpty(localErrorMessage)
    ? localErrorMessage
    : Error switch
    {
        "name" => "Please enter your full name using no more than 100 characters.",
        "email" => "Please enter a valid email address without spaces.",
        "duplicate" => "This email is already registered.",
        "password" => "Your password does not meet the security requirements.",
        "unavailable" => "We couldn't create your account. Please try again.",
        "confirmation" => "Please enter the same password in both password fields.",
        _ => ""
    };

    // Match the server-side Identity password validators.
    private bool hasMinLength => password.Length >= 8;
    private bool hasUpperCase => password.Any(char.IsUpper);
    private bool hasNumber => password.Any(char.IsDigit);
    private bool hasSpecialChar => password.Any(character =>
        !char.IsLetterOrDigit(character) && !char.IsWhiteSpace(character));

    private void CheckPasswordStrength(ChangeEventArgs e) =>
        password = e.Value?.ToString() ?? "";

     /// <summary>
/// Stops invalid password submissions without reloading or clearing the form.
/// The HTTP endpoint and Identity still perform authoritative validation.
/// </summary>
private bool ValidateRegistration()
{
    // Identify the password requirements that still need attention.
    var missingRequirements = new List<string>();

    if (!hasMinLength)
        missingRequirements.Add("at least 8 characters");

    if (!hasUpperCase)
        missingRequirements.Add("an uppercase letter");

    if (!hasNumber)
        missingRequirements.Add("a number");

    if (!hasSpecialChar)
        missingRequirements.Add(
            "a special character other than whitespace");

    var errors = new List<string>();

    if (missingRequirements.Count > 0)
    {
        errors.Add(
            "Your password must include " +
            string.Join(", ", missingRequirements) + ".");
    }

    // Compare both passwords exactly, including capitalization and spaces.
    if (string.IsNullOrEmpty(confirmPassword) ||
        !string.Equals(
            password,
            confirmPassword,
            StringComparison.Ordinal))
    {
        errors.Add(
            "Password and confirmation must match exactly.");
    }

    // Replace stale feedback and refresh the page without navigating away.
    Error = null;
    localErrorMessage = string.Join(" ", errors);
    StateHasChanged();

    return errors.Count == 0;
    }
    protected override void OnInitialized()
    {
        if (AuthService.IsLoggedIn)
            NavManager.NavigateTo(AuthService.IsAdmin ? "/admin" : "/");
    }
}
