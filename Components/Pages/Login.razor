@page "/login"
@layout LoginLayout
@inject PetShopApp.Services.AuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Login | Pet Love Care</PageTitle>

<section class="login-page">
    <div class="login-grid">

        @* Present the brand alongside the login form. *@
        <section class="login-intro" aria-labelledby="login-welcome">
            <a href="/" aria-label="Pet Love Care homepage">
                <img src="/images/pet-love-care-logo.png"
                     class="login-intro-logo"
                     alt="Pet Love Care" />
            </a>

            <h2 id="login-welcome">Hello, Pet Lover!</h2>

            <p>
                The best products for your beloved pet.
                High-quality, certified products. 100% guarantee!
            </p>
        </section>

        @* Keep the authentication form inside a white card. *@
        <section class="login-card" aria-labelledby="login-heading">
            <a href="/"
               class="login-card-brand"
               aria-label="Pet Love Care homepage">
                <img src="/images/pet-love-care-logo-letters-red.webp"
                     alt="Pet Love Care" />
            </a>

            <h1 id="login-heading">Login</h1>

            <p class="login-register">
                Don't have an account?
                <a href="/register">Register now</a>
            </p>

            <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
                <div class="login-field">
                    <label for="login-email">Email</label>

                    <input id="login-email"
                           class="login-input"
                           type="email"
                           autocomplete="username"
                           @bind="email"
                           @bind:event="oninput"
                           disabled="@isSigningIn"
                           required />
                </div>

                <div class="login-field login-field-password">
                    <label for="login-password">Password</label>

                    <input id="login-password"
                           class="login-input"
                           type="password"
                           autocomplete="current-password"
                           @bind="password"
                           @bind:event="oninput"
                           disabled="@isSigningIn"
                           required />

                    <a href="/forgot-password" class="login-forgot">
                        Forgot password?
                    </a>
                </div>

                @* Display authentication errors without leaving the form. *@
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-feedback" role="alert">
                        @errorMessage
                    </div>
                }

                <button type="submit"
                        class="login-submit"
                        disabled="@isSigningIn">
                    @(isSigningIn ? "Signing in..." : "Sign in")
                </button>
            </form>
        </section>
    </div>
</section>

@code {
    // Store credentials, feedback and submission state.
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool isSigningIn;

    /// <summary>
    /// Authenticates the user and opens the appropriate landing page.
    /// </summary>
    private async Task HandleLogin()
    {
        // Prevent simultaneous login attempts.
        if (isSigningIn)
            return;

        errorMessage = "";

        // Validate the required credentials before contacting the service.
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your email and password.";
            return;
        }

        isSigningIn = true;

        try
        {
            var success = await AuthService.Login(email, password);

            if (!success)
            {
                errorMessage = "Invalid credentials.";
                return;
            }

            // Send customers to the homepage and admins to their dashboard.
            NavManager.NavigateTo(AuthService.IsAdmin ? "/admin" : "/");
        }
        catch (Exception ex)
        {
            // Keep technical details in the application logs.
            Console.Error.WriteLine($"Login failed: {ex}");
            errorMessage = "We couldn't sign you in. Please try again.";
        }
        finally
        {
            isSigningIn = false;
        }
    }

    /// <summary>
    /// Redirects users who already have an authenticated session.
    /// </summary>
    protected override void OnInitialized()
    {
        if (AuthService.IsLoggedIn)
        {
            NavManager.NavigateTo(AuthService.IsAdmin ? "/admin" : "/");
        }
    }
}