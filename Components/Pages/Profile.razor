@page "/profile"
@using PetShopApp.Models
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using PetShopApp.Components.Shared
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject PetShopApp.Services.AuthService AuthService
@inject IDbContextFactory<PetShopApp.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavManager

@* --- INTERACTIVE ACCOUNT PROFILE PAGE ---
    Purpose: Allows users to view and update their personal/shipping information.
    Changes are persisted to the database via ProductService.
*@

<PageTitle>My Profile | Pet Love Care</PageTitle>

@if (AuthService.CurrentUser == null)
{
    <div class="container text-center mt-5 py-5">
        <i class="bi bi-lock display-1 text-muted"></i>
        <p class="lead mt-3">Please login to view your profile.</p>
        <a href="/login" class="btn btn-dark rounded-0 px-5 fw-bold">GO TO LOGIN</a>
    </div>
}
else
{
    <div class="container mt-5 mb-5">
        <div class="row">
            
            @* --- LEFT COLUMN: EDITABLE PROFILE FORM --- *@
            <div class="col-md-4 mb-4">
                <div class="card bg-white text-dark rounded-0 border p-4 shadow-sm">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-circle display-1"></i>
                        <h3 class="fw-bold mt-2 text-uppercase" style="letter-spacing: 2px;">My Account</h3>
                    </div>

                    <EditForm Model="@profileModel" OnValidSubmit="HandleUpdate">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small" />

                        <div class="mb-3">
                            <label class="fw-bold text-secondary text-uppercase x-small">Full Name</label>
                            <InputText @bind-Value="@profileModel.Name"
                                       class="form-control form-control-sm rounded-0 border-dark" />
                        </div>

                        <div class="mb-3">
                            <label for="profile-email"
                                class="fw-bold text-secondary text-uppercase x-small">
                                Email (Read-only)
                            </label>

                            <input id="profile-email"
                                type="email"
                                value="@AuthService.CurrentUser?.Email"
                                class="form-control form-control-sm rounded-0 bg-light"
                                readonly />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold text-secondary text-uppercase x-small">Phone</label>
                            <InputText @bind-Value="@profileModel.Phone"
                                       class="form-control form-control-sm rounded-0 border-dark" placeholder="Enter phone" />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold text-secondary text-uppercase x-small">Shipping Address</label>
                            <InputText @bind-Value="@profileModel.Address"
                                       class="form-control form-control-sm rounded-0 border-dark"
                                       placeholder="Street name and number" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="fw-bold text-secondary text-uppercase x-small">City</label>
                                <InputText @bind-Value="@profileModel.City"
                                           class="form-control form-control-sm rounded-0 border-dark" />
                            </div>
                            <div class="col-6">
                                <label class="fw-bold text-secondary text-uppercase x-small">Zip Code</label>
                                <InputText @bind-Value="@profileModel.ZipCode"
                                           class="form-control form-control-sm rounded-0 border-dark" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold text-secondary text-uppercase x-small">Country</label>
                            <InputText @bind-Value="profileModel.Country"
                                       class="form-control form-control-sm rounded-0 border-dark" />
                        </div>
                        <button type="submit"
                            class="btn btn-dark btn-sm w-100 rounded-0 fw-bold mb-2 py-2"
                            disabled="@isSaving">
                            @(isSaving ? "SAVING..." : "UPDATE PROFILE")
                        </button>
                    </EditForm>

                    
                     @* Remove the authentication cookie through a protected HTTP POST. *@
                    <AccountForm Action="/account/logout">
                        <button type="submit"
                            class="btn btn-outline-danger btn-sm w-100 rounded-0 fw-bold py-2">
                        LOGOUT
                        </button>
                     </AccountForm>
                     @if (!string.IsNullOrEmpty(statusMessage))
                    {
                            <div role="status"
                                class="alert @(saveFailed ? "alert-danger" : "alert-success") mt-3 rounded-0 small p-2 text-center">
                                @statusMessage
                            </div>
                    }
                    
                </div>
            </div>

            @* --- RIGHT COLUMN: ORDER HISTORY --- *@
            <div class="col-md-8">
                <CustomerOrderHistory/>

                <div class="d-flex justify-content-end mt-4">
                    <a href="/catalog" class="btn btn-outline-dark rounded-0 px-4 py-2 fw-bold">
                        CONTINUE SHOPPING
                    </a>
                </div>
            </div>
        </div>
    </div>
    }

<style>
    .x-small {
        font-size: 0.65rem;
        letter-spacing: 1px;
    }

    .form-control:focus {
        border-color: #CCFF00;
        box-shadow: none;
    }
</style>

@code {
    private ProfileForm profileModel = new();
    private bool isSaving;
    private bool saveFailed;
    private string statusMessage = "";

    protected override void OnInitialized()
    {
        if (AuthService.CurrentUser is not { } user)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        profileModel = new ProfileForm
        {
            Name = user.Name,
            Phone = user.Phone ?? "",
            Address = user.Address ?? "",
            City = user.City ?? "",
            ZipCode = user.ZipCode ?? "",
            Country = user.Country ?? ""
        };
    }

    private async Task HandleUpdate()
    {
        // Reject deleted accounts and sessions with an invalid security stamp.
        if (!await AuthService.IsAuthorizedAsync())
        {
            NavManager.NavigateTo("/login");
            return;
        }
        
        if (isSaving)
            return;

        if (AuthService.CurrentUser is not { } currentUser)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        statusMessage = "";
        saveFailed = false;

        if (string.IsNullOrWhiteSpace(profileModel.Name))
        {
            saveFailed = true;
            statusMessage = "Please enter your full name.";
            return;
        }

        isSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // The account comes from the current session, not a form field.
            var user = await db.Users
                .SingleOrDefaultAsync(u => u.Id == currentUser.Id);

            if (user is null)
            {
                AuthService.ClearSession();
                NavManager.NavigateTo("/login");
                return;
            }

            user.Name = profileModel.Name.Trim();
            user.Phone = profileModel.Phone.Trim();
            user.Address = profileModel.Address.Trim();
            user.City = profileModel.City.Trim();
            user.ZipCode = profileModel.ZipCode.Trim();
            user.Country = profileModel.Country.Trim();

            await db.SaveChangesAsync();

            // Refresh the session only after a successful save.
            if (ReferenceEquals(AuthService.CurrentUser, currentUser))
            {
                currentUser.Name = user.Name;
                currentUser.Phone = user.Phone;
                currentUser.Address = user.Address;
                currentUser.City = user.City;
                currentUser.ZipCode = user.ZipCode;
                currentUser.Country = user.Country;
            }

            statusMessage = "Profile updated successfully!";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            saveFailed = true;
            statusMessage = "We couldn't save your profile. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

      public sealed class ProfileForm
    {
        [Required(ErrorMessage = "Please enter your full name.")]
        [StringLength(100)]
        public string Name { get; set; } = "";

        [StringLength(30)]
        public string Phone { get; set; } = "";

        [StringLength(200)]
        public string Address { get; set; } = "";

        [StringLength(100)]
        public string City { get; set; } = "";

        [StringLength(20)]
        public string ZipCode { get; set; } = "";

        [StringLength(100)]
        public string Country { get; set; } = "";
    }
}