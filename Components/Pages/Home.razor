@page "/"
@using PetShopApp.Services

<PageTitle>Home</PageTitle>

<div class="banner overflow-hidden d-flex flex-column justify-content-center">
    <img class="banner-img d-block" style="object-position: center;" src="/images/pet-love-care-banner-image.webp" alt="Woman lying on the floor, smiling at a cat beside her.">
    <div class="banner-callToAction d-flex">
        <img class="callToAction-img" src="/images/pet-love-care-logo-letters-red.webp" alt="Pet Love Care logo in red." />
        <button>
            <a href="/catalog"><p>ALL PRODUCTS WITH <span>@(StorePromotion.DiscountPercent)% OFF</span></p></a>
        </button>
        <p class="callToAction-pOff">@(StorePromotion.DiscountPercent)% OFF</p>
    </div>
</div>

<div class="mainContainer">
    <section class="mainSection discoverSection">
        <div class="mainSection-content">
            <h1 class="mainSection-title">DISCOVER OUR PRODUCTS</h1>
            <p class="mainSection-p">Explore our curated collection of premium food, durable toys, and cozy essentials tailored for every stage of your pet's life.</p>
            <button class="mainSection-btn">
                <a href="/catalog"><p>EXPLORE OUR CATALOG</p></a>
            </button>
        </div>
        <img src="/images/explore-section.webp" alt="Cat exploring.">
    </section>

    <section class="mainSection qualitySection">
        <div class="mainSection-content">
            <h1 class="mainSection-title">QUALITY YOU CAN TRUST</h1>
            <p class="mainSection-p">Your pet's health and happiness come first. That is why we carefully source non-toxic toys, nutritious treats, and ergonomic accessories built to withstand everyday play and adventure.</p>
        </div>
        <img src="/images/quality-section.webp" alt="Woman with her pet.">
    </section>

    <section class="mainSection likeFamilySection">
        <div class="mainSection-content">
            <i class="bi bi-chat-square-quote"></i>
            <p class="mainSection-p">We started with a simple mission: to provide safe, durable, and thoughtfully designed products that keep tails wagging and purrs coming. Every item in our store is tested and approved by pet lovers just like you.</p>
        </div>
    </section>

    <section class="mainSection helpingSection">
        <div class="mainSection-content">
            <h1 class="mainSection-title">NEED A HELPING PAW?</h1>
            <p class="mainSection-p">Have a question about sizing, ingredients, or your order? Our dedicated team of pet specialists is here to help you find the perfect fit.</p>
            <button class="mainSection-btn">
                <a href="/contact"><p>CONTACT US</p></a>
            </button>
        </div>
        <img src="/images/contact-us-section.webp" alt="Dog listening.">
    </section>
</div>