@page "/admin/products"
@using PetShopApp.Models
@using PetShopApp.Services
@inject NavigationManager NavManager
@inject AuthService AuthService
@inject ProductAdministrationService ProductAdministration
@inject IJSRuntime JS
@inject ILogger<AdminProducts> Logger
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@* --- ADMIN PRODUCT MANAGEMENT ---
   Purpose: Centralized dashboard for administrators to manage the pet product inventory.
   Features: Dynamic search, image previewing, and a dual-purpose Create/Edit form.
*@

<PageTitle>Product Administration | Pet Love Care</PageTitle>

<div class="container mt-5 pt-5 pb-5">
    <h2 class="fw-bold text-uppercase mb-4">Admin Product Inventory</h2>

    @* --- SECURITY LAYER --- *@
    @if (!AuthService.IsAdmin)
    {
        <div class="alert alert-danger rounded-0">
            Access denied. Administrators only.
        </div>
    }
    else
    {
        @* Show validation and operation feedback without clearing failed edits. *@
        @if (!string.IsNullOrEmpty(productError))
        {
            <div class="alert alert-danger rounded-0" role="alert">@productError</div>
        }
        @if (!string.IsNullOrEmpty(inventoryMessage))
        {
            <div class="alert alert-success rounded-0" role="status">@inventoryMessage</div>
        }
        @if (isLoading)
        {
            <p role="status">Loading inventory...</p>
        }

        @* Disable editing during a load or mutation to prevent repeated submissions. *@
        <fieldset disabled="@(isBusy || isLoading)" class="border-0 p-0 m-0" style="min-width: 0;">
        @* --- PRODUCT FORM (CREATE / EDIT) --- *@
        <div class="card rounded-0 mb-4 shadow-sm">
            <div class="card-header bg-dark text-white text-uppercase small fw-bold">
                @* Toggle header text based on whether an ID exists *@
                @(editingProduct.Id == 0 ? "Add New Product" : "Edit Product")
            </div>

            <div class="card-body">
                <EditForm @key="editingProduct" @ref="productEditForm" Model="@editingProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        @* Basic Product Info Inputs *@
                        <div class="col-md-4">
                            <label for="admin-product-name" class="form-label small fw-bold">Product Name</label>
                            <InputText id="admin-product-name" required maxlength="200" @bind-Value="editingProduct.Name" class="form-control rounded-0" />
                        </div>

                        @* Same-price options share this count; priced variants use their own fields below. *@
                        @if (existingVariants.Count == 0 && pendingVariants.Count == 0)
                        {
                            <div class="col-md-3">
                                <label for="admin-product-stock" class="form-label small fw-bold">Stock quantity</label>
                                <InputNumber id="admin-product-stock" min="0" step="1"
                                             @bind-Value="editingProduct.StockQuantity" class="form-control rounded-0" />
                                <small class="text-muted">Units available. Zero means OUT OF STOCK.</small>
                            </div>
                        }

                        <div class="col-md-3">
                            <label for="admin-product-price" class="form-label small fw-bold">Price</label>
                            <InputNumber id="admin-product-price" min="0" step="0.01" @bind-Value="editingProduct.Price" class="form-control rounded-0" />
                        </div>

                        <div class="col-md-5">
                            <label for="admin-product-image" class="form-label small fw-bold">Primary Image Path

                            </label>
                            <InputText id="admin-product-image" @bind-Value="editingProduct.ImageUrl" class="form-control rounded-0"
                                       placeholder="/images/imageF1.png" />
                        </div>

                        @* Image Gallery Management: Uses a raw string processed by new lines *@
                        <div class="col-12">
                            <label for="admin-product-gallery" class="form-label small fw-bold">Additional Image Paths</label>
                            <InputTextArea id="admin-product-gallery" @bind-Value="secondaryImagesText" class="form-control rounded-0" rows="4" />
                            <small class="text-muted d-block mt-2">
                                One image path per line.<br />
                                /images/imageB1.png<br />
                                /images/imageFm1.png<br />
                                /images/imageBf1.png
                            </small>
                        </div>

                        <div class="col-12">
                            <label for="admin-product-description" class="form-label small fw-bold">Description</label>
                            <InputTextArea id="admin-product-description" @bind-Value="editingProduct.Description" class="form-control rounded-0" />
                        </div>
                        <div class="col-12">
                        <label for="more-information" class="form-label small fw-bold">
                            More Information
                        </label>
                        <InputTextArea id="more-information"
                                    class="form-control rounded-0"
                                    rows="4"
                                    @bind-Value="editingProduct.MoreInformation" />
                        </div>
                        <div class="col-md-6">
                            <label for="animal-type" class="form-label small fw-bold">Animal Type</label>
                            <InputSelect id="animal-type" @bind-Value="editingProduct.AnimalTypeId"
                                        class="form-select rounded-0">
                                <option value="0">Select an animal type</option>
                                @foreach (var animal in animalTypes)
                                {
                                    <option value="@animal.Id">@animal.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label for="product-category" class="form-label small fw-bold">Category</label>
                            <InputSelect id="product-category" @bind-Value="editingProduct.CategoryId"
                                        class="form-select rounded-0">
                                <option value="">No category selected</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12">
                                <label for="product-options" class="form-label small fw-bold">
                                    Product Options (same price)
                                </label>
                                <InputText id="product-options"
                                        class="form-control rounded-0"
                                        @bind-Value="editingProduct.AvailableOptionsRaw"
                                        placeholder="2.2 lb, 11 lb, 22 lb, 44 lb" />
                                <small class="text-muted">
                                    Separate labels with commas; all use the product price. For different prices, leave this blank and use Product Variants below. Priced variants take priority when both are present.
                                </small>
                            </div>
                        @* Variant prices are optional and can be prepared before the product exists. *@
                        <div class="col-12 border-top mt-4 pt-3">
                            <h5>Product Variants</h5>
                            <p class="small text-muted">
                                Add options with their own prices. Leave all variant fields blank for a product without priced variants.
                                New product variants are saved together when you click Create Product.
                            </p>
                            <div @key="newVariant" class="row g-2 align-items-end">
                                <div class="col-12 col-md-4">
                                    <label for="variant-label" class="form-label">Option</label>
                                    <InputText id="variant-label" maxlength="100" class="form-control"
                                               @bind-Value="newVariant.Label" placeholder="2.2 lb" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="variant-price" class="form-label">Unit Price</label>
                                    <InputNumber id="variant-price" min="0.01" step="0.01"
                                                 class="form-control" @bind-Value="newVariant.Price" />
                                </div>
                                <div class="col-12 col-md-2">
                                    <label for="variant-stock" class="form-label">Stock quantity</label>
                                    <InputNumber id="variant-stock" min="0" step="1" class="form-control"
                                                 @bind-Value="newVariant.StockQuantity" />
                                </div>
                                <div class="col-12 col-md-2">
                                    <button type="button" class="btn btn-dark w-100" @onclick="AddVariantAsync">
                                        Add Variant
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(variantMessage))
                            {
                                <p class="mt-2" role="status">@variantMessage</p>
                            }
                            @if (pendingVariants.Count > 0)
                            {
                                <h6 class="mt-3">Variants to save</h6>
                                <ul class="list-group mt-2">
                                    @foreach (var variant in pendingVariants)
                                    {
                                        <li @key="variant" class="list-group-item d-flex flex-wrap gap-2 justify-content-between align-items-center">
                                            <span>@variant.Label — @variant.Price.ToString("C") — Stock: @variant.StockQuantity</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    aria-label="@($"Remove {variant.Label}")"
                                                    @onclick="() => RemovePendingVariant(variant)">
                                                Remove
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            @if (existingVariants.Count > 0)
                            {
                                <h6 class="mt-3">Saved variants</h6>
                                <ul class="list-group mt-2">
                                    @foreach (var variant in existingVariants)
                                    {
                                        <li @key="variant.Id" class="list-group-item d-flex flex-wrap align-items-end gap-3">
                                            <span>@variant.Label — @variant.Price.ToString("C")</span>
                                            <div>
                                                <label for="@($"saved-stock-{variant.Id}")" class="form-label small">Stock quantity</label>
                                                <InputNumber id="@($"saved-stock-{variant.Id}")" min="0" step="1"
                                                             class="form-control" style="max-width: 130px;"
                                                             @bind-Value="variant.StockQuantity" />
                                            </div>
                                            <button type="button" class="btn btn-outline-dark rounded-0"
                                                    @onclick="() => SaveVariantStockAsync(variant)">Update stock</button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        @* Action Buttons for the Form *@
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-dark rounded-0">
                                @(editingProduct.Id == 0 ? "Create Product" : "Update Product")
                            </button>

                            <button type="button" class="btn btn-outline-secondary rounded-0" @onclick="ResetForm">
                                Cancel
                            </button>
                        </div>
                    </div>

                </EditForm>

            </div>
        </div>

        @* --- INVENTORY TABLE & SEARCH --- *@
        <div class="card rounded-0 shadow-sm">
            <div class="card-body">

                @* Live Search Filter *@
                <div class="row g-2 mb-3">
                    <div class="col-md-8">
                        <input class="form-control rounded-0" @bind="searchTerm" @bind:event="oninput"
                               placeholder="Search product..." />
                    </div>

                    <div class="col-md-4">
                        <button class="btn btn-outline-dark rounded-0 w-100" @onclick="LoadProducts">
                            Refresh List
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table border align-middle">
                        <thead class="table-dark small text-uppercase">
                            <tr>
                                <th>ID</th>
                                <th>Preview</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @* Uses the Computed Property FilteredProducts for real-time results *@
                            @foreach (var p in FilteredProducts)
                            {
                                <tr @key="p.Id">
                                    <td>@p.Id</td>
                                    <td>
                                        <img src="@GetImageUrl(p.ImageUrl)" alt="@p.Name"
                                             style="width:50px;height:50px;object-fit:cover;display:block;background-color:#f8f9fa;"
                                             onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                                    </td>
                                    <td>@p.Name</td>
                                    <td>@p.Price.ToString("C")</td>
                                    <td>@(p.Variants.Count > 0 ? p.Variants.Sum(variant => (long)variant.StockQuantity) : p.StockQuantity)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" type="button" @onclick="() => EditProduct(p)">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteProduct(p)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (!FilteredProducts.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No products found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        </fieldset>
    }
</div>

@code {
    private List<Product> products = new();
    private List<AnimalType> animalTypes = new();
    private List<Category> categories = new();
    private Product editingProduct = new();
    private VariantInput newVariant = new();
    private EditForm? productEditForm;
    private readonly List<ProductVariantDraft> pendingVariants = new();
    private List<ProductVariant> existingVariants = new();
    private Dictionary<int, int> originalVariantStock = new();
    private int originalProductStock;
    private string searchTerm = "";
    private string secondaryImagesText = "";
    private string productError = "";
    private string inventoryMessage = "";
    private string variantMessage = "";
    private bool isLoading = true;
    private bool isBusy;

    // Search only the detached inventory returned by the authorized service.
    private IEnumerable<Product> FilteredProducts =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? products
            : products.Where(product => product.Name.Contains(
                searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await RefreshInventoryAsync();
    }

    /// <summary>
    /// Refreshes data through the service and handles a revoked administrator session.
    /// </summary>
    private async Task RefreshInventoryAsync()
    {
        isLoading = true;
        try
        {
            var inventory = await ProductAdministration.GetInventoryAsync();
            products = inventory.Products;
            animalTypes = inventory.AnimalTypes;
            categories = inventory.Categories;
            existingVariants = products.FirstOrDefault(product => product.Id == editingProduct.Id)
                ?.Variants.OrderBy(variant => variant.Id).ToList() ?? new List<ProductVariant>();
            originalVariantStock = existingVariants.ToDictionary(variant => variant.Id, variant => variant.StockQuantity);
        }
        catch (UnauthorizedAccessException)
        {
            NavManager.NavigateTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Inventory refresh failed.");
            productError = "We couldn't refresh the inventory. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Handles an explicit refresh without overlapping a pending mutation.
    /// </summary>
    private async Task LoadProducts()
    {
        if (isBusy || isLoading)
            return;

        productError = "";
        inventoryMessage = "";
        await RefreshInventoryAsync();
    }

    /// <summary>
    /// Copies editable fields without sharing tracked entities with the edit form.
    /// </summary>
    private void EditProduct(Product product)
    {
        if (isBusy || isLoading)
            return;

        editingProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            MoreInformation = product.MoreInformation,
            AnimalTypeId = product.AnimalTypeId,
            CategoryId = product.CategoryId,
            Category = product.Category,
            Price = product.Price,
            StockQuantity = product.StockQuantity,
            ImageUrl = product.ImageUrl,
            SecondaryImageUrlsRaw = product.SecondaryImageUrlsRaw,
            AvailableOptionsRaw = product.AvailableOptionsRaw
        };
        originalProductStock = product.StockQuantity;
        originalVariantStock = product.Variants.ToDictionary(variant => variant.Id, variant => variant.StockQuantity);
        secondaryImagesText = product.SecondaryImageUrlsRaw;
        pendingVariants.Clear();
        existingVariants = product.Variants.OrderBy(variant => variant.Id).ToList();
        newVariant = new VariantInput();
        productError = "";
        variantMessage = "";
        inventoryMessage = "";
    }

    /// <summary>
    /// Keeps entered values when service validation fails and resets only after success.
    /// </summary>
    private async Task SaveProduct()
    {
        if (isBusy || isLoading)
            return;

        isBusy = true;
        productError = "";
        inventoryMessage = "";
        try
        {
            var isNew = editingProduct.Id == 0;
            editingProduct.SecondaryImageUrlsRaw = secondaryImagesText;
            var variantsToSave = pendingVariants.ToList();

            // Include a completed editor row even if Add Variant was not clicked.
            var enteredVariant = ReadVariantEditor();
            if (enteredVariant is not null)
                variantsToSave.Add(enteredVariant);

            await ProductAdministration.SaveProductAsync(editingProduct, variantsToSave, originalProductStock);
            ResetForm();
            inventoryMessage = isNew ? "Product created successfully." : "Product updated successfully.";
            await RefreshInventoryAsync();
        }
        catch (ArgumentException exception)
        {
            productError = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            NavManager.NavigateTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Product save failed.");
            productError = "We couldn't save the product. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// Requests browser confirmation before invoking the protected deletion operation.
    /// </summary>
    private async Task DeleteProduct(Product product)
    {
        if (isBusy || isLoading)
            return;

        isBusy = true;
        productError = "";
        inventoryMessage = "";
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Delete \"{product.Name}\"? Purchased order history will be preserved.");
            if (!confirmed)
                return;

            var deleted = await ProductAdministration.DeleteProductAsync(product.Id);
            if (editingProduct.Id == product.Id)
                ResetForm();
            inventoryMessage = deleted
                ? "Product deleted successfully. Purchased order history was preserved."
                : "This product was already removed. The inventory has been refreshed.";
            await RefreshInventoryAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavManager.NavigateTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Product deletion failed.");
            productError = "We couldn't delete the product. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// Stages variants for an unsaved product or saves a new option for an existing product.
    /// </summary>
    private async Task AddVariantAsync()
    {
        if (isBusy || isLoading)
            return;

        isBusy = true;
        productError = "";
        variantMessage = "";
        try
        {
            var variant = ReadVariantEditor()
                ?? throw new ArgumentException("Enter an option and its unit price before adding a variant.");

            if (pendingVariants.Any(item => item.Label == variant.Label))
                throw new ArgumentException("This option is already in the draft.");

            if (editingProduct.Id == 0)
            {
                // No database row is created until the complete product is submitted.
                pendingVariants.Add(variant);
                variantMessage = "Variant added to the draft. Click Create Product to save it.";
            }
            else
            {
                await ProductAdministration.AddVariantAsync(
                    editingProduct.Id, variant.Label, variant.Price, variant.StockQuantity);
                variantMessage = "Product option saved successfully.";
                await RefreshInventoryAsync();
            }

            newVariant = new VariantInput();
        }
        catch (ArgumentException exception)
        {
            productError = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            NavManager.NavigateTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Product option creation failed.");
            productError = "We couldn't save the option. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// Saves a variant count separately and rejects stale inventory instead of undoing a sale.
    /// </summary>
    private async Task SaveVariantStockAsync(ProductVariant variant)
    {
        if (isBusy || isLoading)
            return;
        productError = "";
        variantMessage = "";
        var field = new FieldIdentifier(variant, nameof(ProductVariant.StockQuantity));
        if (productEditForm?.EditContext?.GetValidationMessages(field).Any() == true)
        {
            productError = "Enter a whole stock quantity of zero or more.";
            return;
        }
        isBusy = true;
        try
        {
            await ProductAdministration.UpdateVariantStockAsync(
                variant.Id, originalVariantStock[variant.Id], variant.StockQuantity);
            variantMessage = "Stock updated successfully.";
            await RefreshInventoryAsync();
        }
        catch (ArgumentException exception)
        {
            productError = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            NavManager.NavigateTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Variant stock update failed.");
            productError = "We couldn't update stock. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// Allows a blank editor and rejects partial rows or invalid numeric input.
    /// </summary>
    private ProductVariantDraft? ReadVariantEditor()
    {
        var priceField = new FieldIdentifier(newVariant, nameof(VariantInput.Price));
        var stockField = new FieldIdentifier(newVariant, nameof(VariantInput.StockQuantity));
        if (productEditForm?.EditContext?.GetValidationMessages(stockField).Any() == true)
            throw new ArgumentException("Enter a whole stock quantity of zero or more.");
        if (productEditForm?.EditContext?.GetValidationMessages(priceField).Any() == true)
            throw new ArgumentException("Enter a valid unit price for the variant.");

        var label = newVariant.Label.Trim();
        if (label.Length == 0 && newVariant.Price is null && newVariant.StockQuantity is null)
            return null;

        if (label.Length == 0 || label.Length > 100 ||
            newVariant.Price is not decimal price || price <= 0 ||
            newVariant.StockQuantity is not int stock || stock < 0)
        {
            throw new ArgumentException("Enter an option, a unit price greater than zero and a stock quantity of zero or more, or leave all variant fields blank.");
        }

        return new ProductVariantDraft(label, price, stock);
    }

    // Removing a pending row changes only this form, never a saved product or order.
    private void RemovePendingVariant(ProductVariantDraft variant)
    {
        if (!isBusy && !isLoading)
            pendingVariants.Remove(variant);
    }

    /// <summary>
    /// A nullable price keeps optional variant inputs genuinely empty at the start.
    /// </summary>
    private sealed class VariantInput
    {
        public string Label { get; set; } = "";
        public decimal? Price { get; set; }
        public int? StockQuantity { get; set; }
    }

    // Replace form models so previous validation state is cleared after a successful action.
    private void ResetForm()
    {
        editingProduct = new Product();
        newVariant = new VariantInput();
        secondaryImagesText = "";
        pendingVariants.Clear();
        existingVariants.Clear();
        originalVariantStock.Clear();
        originalProductStock = 0;
        productError = "";
        variantMessage = "";
        inventoryMessage = "";
    }

    // Use the existing placeholder when an image path has not been supplied.
    private static string GetImageUrl(string? url) =>
        string.IsNullOrWhiteSpace(url) ? "/images/placeholder.png" : url.Trim();
}
