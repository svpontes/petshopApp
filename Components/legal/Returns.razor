@page "/returns-exchanges"

<PageTitle>Returns &amp; Exchanges | Pet Love Care</PageTitle>

<div class="container mt-5 pt-5 pb-5 pet-page">
    <h1 class="fw-bold text-uppercase mb-4" style="letter-spacing: 3px;">
        Returns &amp; Exchanges
    </h1>

    <div class="row">
        <div class="col-lg-7">
            <p class="lead mb-4">
                Ordered the wrong size or need to return a pet product?
                Contact us within 14 days of delivery to request a return or exchange.
            </p>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Before You Return an Item</h2>
                <ul class="text-secondary">
                    <li class="mb-2">
                        Keep your order number and the original packaging.
                    </li>
                    <li class="mb-2">
                        For a standard return, keep accessories and supplies
                        unused, with any original tags attached.
                    </li>
                    <li class="mb-2">
                        If you opened pet food or treats, contact us first
                        so we can review your request before you send anything back.
                    </li>
                    <li class="mb-2">
                        Customers pay return shipping for standard returns.
                    </li>
                </ul>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">How to Request a Return or Exchange</h2>
                <ol class="text-secondary">
                    <li class="mb-2">
                        Open our <a href="/contact">Contact Us</a> page and select
                        <strong>Returns &amp; Exchanges</strong>.
                    </li>
                    <li class="mb-2">
                        Include your order number, the product name, and the size
                        or bag weight, if applicable. Tell us why you want to
                        return it or which option you would like instead.
                    </li>
                    <li class="mb-2">
                        Wait for return instructions before mailing the item.
                    </li>
                </ol>
            </section>

            <section class="bg-light border rounded p-3">
                <h2 class="h5 fw-bold">Damaged, Incorrect, or Missing Items</h2>
                <p class="text-secondary mb-0">
                    If an item arrived damaged, you received the wrong product,
                    or something is missing, <a href="/contact">contact us</a>
                    with your order number and a description of the problem.
                    If the package is damaged, keep it and take a photo so you
                    have it available if we ask for it.
                </p>
            </section>
        </div>
    </div>
</div>