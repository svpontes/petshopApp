@using PetShopApp.Models
@using PetShopApp.Services
@inject CustomerOrderHistoryService OrderHistoryService
@inject AuthService AuthService
@inject ProductService ProductService
@inject CartService CartService

@if (!AuthService.IsLoggedIn)
{
    <p>Please sign in to view your orders.</p>

    <a href="/login" class="btn btn-dark rounded-0">
        SIGN IN
    </a>
}
else
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <h2 class="fw-bold text-uppercase mb-0"
            style="letter-spacing: 2px;">
            Order History
        </h2>

        <button type="button"
                class="btn btn-outline-dark btn-sm rounded-0"
                disabled="@(isLoading || isReordering)"
                @onclick="LoadOrdersAsync">
            @(isLoading ? "LOADING..." : "REFRESH")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(reorderMessage))
    {
        <div class="alert @(reorderFailed ? "alert-warning" : "alert-success") rounded-0"
             role="status">
            @reorderMessage

            @if (!reorderFailed)
            {
                <a href="/cart" class="alert-link ms-2">
                    VIEW BAG
                </a>
            }
        </div>
    }

    @if (isLoading)
    {
        <p class="text-secondary" role="status">
            Loading your orders...
        </p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger rounded-0" role="alert">
            @errorMessage
        </div>
    }
    else if (orders.Count == 0)
    {
        <div class="border p-4 text-center">
            <h3 class="h5 fw-bold">No orders yet.</h3>

            <p class="text-secondary">
                Your purchases will appear here after you place an order.
            </p>

            <a href="/catalog" class="btn btn-dark rounded-0">
                DISCOVER PRODUCTS
            </a>
        </div>
    }
    else
    {
        @foreach (var order in orders)
        {
            <article @key="order.Id" class="card rounded-0 mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-3">
                        <div>
                            <h3 class="h5 fw-bold">Order #@order.Id</h3>

                            <p class="small text-secondary mb-0">
                                @order.OrderDate.ToString("MMM dd, yyyy HH:mm")
                            </p>
                        </div>

                        <div class="text-end">
                            <span class="badge bg-dark rounded-0">
                                @order.Status
                            </span>

                            <p class="fw-bold mt-2 mb-0">
                                Total: @order.TotalAmount.ToString("C")
                            </p>
                        </div>
                    </div>

                    <details class="mt-3">
                        <summary class="fw-bold">
                            View purchased items
                        </summary>

                        <div class="table-responsive mt-3">
                            <table class="table align-middle mb-0">
                                <caption class="visually-hidden">
                                    Items purchased in order #@order.Id
                                </caption>

                                <thead>
                                    <tr>
                                        <th scope="col">Product</th>
                                        <th scope="col">Option</th>
                                        <th scope="col">Quantity</th>
                                        <th scope="col">Unit price</th>
                                        <th scope="col">Subtotal</th>
                                        <th scope="col" class="text-end">
                                            Buy again
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl) &&
                                                         !failedImageUrls.Contains(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl"
                                                             alt="@item.ProductName"
                                                             class="order-history-product-image"
                                                             width="80"
                                                             height="80"
                                                             loading="lazy"
                                                             @onerror="() => { failedImageUrls.Add(item.ImageUrl); }" />
                                                    }
                                                    else
                                                    {
                                                        <span class="order-history-image-placeholder"
                                                              role="img"
                                                              aria-label="Product image unavailable">
                                                            <i class="bi bi-image"
                                                               aria-hidden="true"></i>
                                                        </span>
                                                    }

                                                    <span>@item.ProductName</span>
                                                </div>
                                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(item.Size)
                                                    ? "Standard"
                                                    : item.Size)
                                            </td>

                                            <td>@item.Quantity</td>

                                            <td>@item.Price.ToString("C")</td>

                                            <td>
                                                @((item.Price * item.Quantity).ToString("C"))
                                            </td>

                                            <td class="text-end">
                                                <button type="button"
                                                        class="btn btn-outline-dark btn-sm rounded-0 text-nowrap"
                                                        disabled="@isReordering"
                                                        @onclick="() => ReorderAsync(item)">
                                                    BUY AGAIN
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </article>
        }
    }
}

@code {
    private List<Order> orders = new();

    private readonly HashSet<string> failedImageUrls =
        new(StringComparer.Ordinal);

    private bool isLoading;
    private string errorMessage = "";

    private bool isReordering;
    private bool reorderFailed;
    private string reorderMessage = "";

    protected override Task OnInitializedAsync()
    {
        return LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        if (isLoading || isReordering)
            return;

        orders.Clear();
        failedImageUrls.Clear();

        errorMessage = "";
        reorderMessage = "";
        reorderFailed = false;

        if (!AuthService.IsLoggedIn)
            return;

        isLoading = true;

        try
        {
            orders = await OrderHistoryService.GetMyOrdersAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);

            errorMessage =
                "We couldn't load your orders. Please try Refresh.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReorderAsync(OrderItem item)
    {
        if (isReordering || isLoading)
            return;

        isReordering = true;
        reorderFailed = true;
        reorderMessage = "";

        try
        {
            var customer = AuthService.CurrentUser;

            if (customer is null)
            {
                reorderMessage = "Please sign in to buy again.";
                return;
            }

            if (item.Quantity <= 0)
            {
                reorderMessage = "This item cannot be reordered.";
                return;
            }

            var product = await ProductService
                .GetProductByIdAsync(item.ProductId);

            if (!ReferenceEquals(AuthService.CurrentUser, customer))
            {
                reorderMessage =
                    "Your session has changed. Please sign in again.";
                return;
            }

            if (product is null)
            {
                reorderMessage = "This product is no longer available.";
                return;
            }

            var previousOption = item.Size?.Trim() ?? "";

            ProductVariant? variant = null;
            string? option;

            if (product.Variants.Count > 0)
            {
                variant = product.Variants.FirstOrDefault(current =>
                    string.Equals(
                        current.Label?.Trim(),
                        previousOption,
                        StringComparison.OrdinalIgnoreCase));

                option = previousOption.Length == 0
                    ? null
                    : variant?.Label;
            }
            else
            {
                var sizes = product.AvailableSizes;

                if (sizes.Count > 0)
                {
                    option = previousOption.Length == 0
                        ? null
                        : sizes.FirstOrDefault(size =>
                            string.Equals(
                                size.Trim(),
                                previousOption,
                                StringComparison.OrdinalIgnoreCase));
                }
                else
                {
                    option = previousOption.Length == 0 ? "" : null;
                }
            }

            if (option is null)
            {
                reorderMessage =
                    "Your previous option is no longer available. " +
                    "Please choose an option from the catalog.";
                return;
            }

            if ((variant?.Price ?? product.Price) < 0)
            {
                reorderMessage =
                    "This product cannot be added right now. Please try later.";
                return;
            }

            // CartService applies the current promotion.
            if (!CartService.AddToCart(product, option, item.Quantity, variant))
            {
                reorderMessage = CartService.LastError;
                return;
            }

            reorderFailed = false;

            reorderMessage =
                $"{item.Quantity} × {product.Name} added to your bag " +
                "using the current price and promotion.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);

            reorderMessage =
                "We couldn't add this item. Please try again.";
        }
        finally
        {
            isReordering = false;
        }
    }
}