@implements IDisposable
@using PetShopApp.Components.Shared
@inject PetShopApp.Services.AuthService AuthService

<nav class="nav d-flex justify-content-end" aria-label="Main navigation">
    <ul class="header-nav-items">
        @* Display the shopping bag and its existing item counter. *@
        <li>
            <a href="/cart"
               class="cart-link"
               aria-label="Shopping cart">
                <i class="bi bi-bag" aria-hidden="true"></i>

                <span class="cart-count">
                    <PetShopApp.Components.Shared.CartBadge />
                </span>
            </a>
        </li>

        <li>
            @if (AuthService.CurrentUser is { } customer)
            {
                @* Open account options when the authenticated user clicks the icon. *@
                <div class="dropdown">
                    @* Display the account icon, greeting and dropdown indicator. *@
                    <button id="header-account-menu"
                            type="button"
                            class="account-toggle"
                            data-bs-toggle="dropdown"
                            data-bs-offset="0,12"
                            aria-expanded="false"
                            aria-label="Open account options">

                        <i class="bi bi-person" aria-hidden="true"></i>

                        <span class="account-greeting-row">
                            <span class="account-greeting" title="@customer.Name">
                                Hello, @GetFirstName(customer.Name)
                            </span>

                            <span class="account-menu-caret"
                                aria-hidden="true"></span>
                        </span>
                    </button>

                    @* Display account actions inside the white dropdown panel. *@
                    <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu"
                        aria-labelledby="header-account-menu">

                        <li>
                            <a href="/profile" class="dropdown-item">
                                My Account
                            </a>
                        </li>

                        <li>
                            @* Use the existing protected logout flow. *@
                            <AccountForm Action="/account/logout">
                                <button type="submit"
                                        class="dropdown-item account-logout">
                                    <i class="bi bi-box-arrow-right"
                                    aria-hidden="true"></i>
                                    End session
                                </button>
                            </AccountForm>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                @* Send visitors to the login page. *@
                <a href="/login"
                   class="account-toggle"
                   aria-label="Sign in">
                    <i class="bi bi-person" aria-hidden="true"></i>
                </a>
            }
        </li>
    </ul>
</nav>

@code {
    /// <summary>
    /// Subscribes to session changes so the menu updates after login and logout.
    /// </summary>
    protected override void OnInitialized()
    {
        AuthService.OnChange += HandleAuthChanged;
    }

    /// <summary>
    /// Returns the first name used in the account greeting.
    /// </summary>
    private static string GetFirstName(string? fullName)
    {
        return fullName?
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault() ?? "Customer";
    }

    /// <summary>
    /// Refreshes the menu on the Blazor rendering context.
    /// </summary>
    private void HandleAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Removes the event subscription when this component is disposed.
    /// </summary>
    public void Dispose()
    {
        AuthService.OnChange -= HandleAuthChanged;
    }
}